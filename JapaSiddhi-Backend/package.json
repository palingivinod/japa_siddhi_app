{
  "name": "japa-siddhi-backend",
  "version": "1.0.0",
  "description": "Japa Siddhi Backend API",
  "main": "dist/server.js",
  "license": "MIT",
  "engines": {
    "node": ">=22 <25"
  },
  "scripts": {
    "dev": "nodemon",
    "build": "tsc && node -e \"require('fs').mkdirSync('dist/database',{recursive:true}); require('fs').copyFileSync('src/database/schema.sqlite.sql','dist/database/schema.sqlite.sql')\"",
    "start": "node dist/server.js",
    "clean": "rimraf dist",
    "lint": "eslint . --ext .ts",
    "format": "prettier --write .",
    "db:reset": "node -e \"require('fs').rmSync('data/japa_siddhi.sqlite',{force:true}); console.log('SQLite database removed');\""
  },
  "dependencies": {
    "archiver": "^8.0.0",
    "bcrypt": "^6.0.0",
    "better-sqlite3": "^13.0.3",
    "compression": "^1.8.1",
    "cors": "^2.8.5",
    "csv-writer": "^1.6.0",
    "dayjs": "^1.11.21",
    "dotenv": "^17.2.2",
    "exceljs": "^4.4.0",
    "express": "^5.1.0",
    "express-rate-limit": "^8.1.0",
    "express-validator": "^7.2.1",
    "firebase-admin": "^13.4.0",
    "helmet": "^8.1.0",
    "jsonwebtoken": "^9.0.2",
    "mime-types": "^3.0.2",
    "morgan": "^1.10.0",
    "multer": "^2.0.2",
    "mysql2": "^3.14.3",
    "nodemailer": "^9.0.5",
    "pdfkit": "^0.19.1",
    "pdfmake": "^0.3.11",
    "socket.io": "^4.8.3",
    "sql.js": "^1.14.2",
    "uuid": "^13.0.0",
    "winston": "^3.17.0"
  },
  "devDependencies": {
    "@types/bcrypt": "^6.0.0",
    "@types/better-sqlite3": "^9.6.0",
    "@types/compression": "^1.8.1",
    "@types/cors": "^2.8.19",
    "@types/express": "^5.0.6",
    "@types/jsonwebtoken": "^9.0.10",
    "@types/morgan": "^1.9.10",
    "@types/multer": "^2.2.0",
    "@types/node": "^24.13.3",
    "@types/nodemailer": "^8.0.1",
    "@types/pdfkit": "^0.17.6",
    "@types/socket.io": "^3.0.2",
    "@types/sql.js": "^1.4.11",
    "@typescript-eslint/eslint-plugin": "^8.41.0",
    "@typescript-eslint/parser": "^8.41.0",
    "eslint": "^9.34.0",
    "nodemon": "^3.1.10",
    "prettier": "^3.6.2",
    "rimraf": "^6.0.1",
    "ts-node": "^10.9.2",
    "typescript": "^5.9.2"
  }
}
