NODE_ENV=development

PORT=5000
DB_ENGINE=postgres
DATABASE_URL=
SQLITE_PATH=

APP_NAME=Japa Siddhi

# Newest Android versionName. Raise this when a new build is published.
LATEST_APP_VERSION=1.1.3

# Razorpay. The key secret and webhook secret stay on the server only.
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=
RAZORPAY_WEBHOOK_SECRET=

APP_URL=http://localhost:5000

MYSQL_HOST=localhost
MYSQL_PORT=3306
MYSQL_DATABASE=japa_siddhi
MYSQL_USER=root
MYSQL_PASSWORD=

JWT_SECRET=CHANGE_THIS_TO_A_LONG_RANDOM_SECRET
JWT_EXPIRES_IN=7d

FIREBASE_PROJECT_ID=
FIREBASE_CLIENT_EMAIL=
FIREBASE_PRIVATE_KEY=

UPLOAD_PATH=uploads

SOCKET_CORS_ORIGIN=*

LOG_LEVEL=info

# Free Gmail SMTP for production OTP. Use a Gmail App Password, not the login password.
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=kailaasavaasi@gmail.com
SMTP_PASS=
NOTIFY_EMAIL=bilvapatratrust@gmail.com
OTP_EXPIRES_SECONDS=300
OTP_RESEND_SECONDS=45
OTP_MAX_ATTEMPTS=5

# Phone OTP: Firebase Auth on the mobile app (no Twilio).
# Leave unset until Firebase phone billing is on. Then set PHONE_OTP_ENABLED=true
# and mobile OTP works without another app build.
PHONE_OTP_ENABLED=false
# Ensure FIREBASE_* / service account above can verifyIdToken.

# VedicOrbit Panchangam API (https://www.vedicorbit.in/api-docs)
VEDICORBIT_API_KEY=
VEDICORBIT_API_BASE_URL=https://vedicorbit-website.vercel.app/api/panchangam
VEDICORBIT_LAT=17.385
VEDICORBIT_LON=78.4867
VEDICORBIT_TIMEZONE=Asia/Kolkata
VEDICORBIT_LANG=en