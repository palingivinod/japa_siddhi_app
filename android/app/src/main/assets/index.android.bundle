mSaraswatyai:'\u0b93\u0bae\u0bcd \u0b90\u0bae\u0bcd \u0b9a\u0bb0\u0bb8\u0bcd\u0bb5\u0ba4\u0bcd\u0baf\u0bc8 \u0ba8\u0bae\u0903',mantraOmShriHanumate:'\u0b93\u0bae\u0bcd \u0bb8\u0bcd\u0bb0\u0bc0 \u0bb9\u0ba9\u0bc1\u0bae\u0ba4\u0bc7 \u0ba8\u0bae\u0903',daySun:'\u0b9e\u0bbe\u0baf\u0bbf',dayMon:'\u0ba4\u0bbf\u0b99\u0bcd',dayTue:'\u0b9a\u0bc6\u0bb5\u0bcd',dayWed:'\u0baa\u0bc1\u0ba4',dayThu:'\u0bb5\u0bbf\u0baf\u0bbe',dayFri:'\u0bb5\u0bc6\u0bb3\u0bcd',daySat:'\u0b9a\u0ba9\u0bbf',monthJan:'\u0b9c\u0ba9\u0bb5\u0bb0\u0bbf',monthFeb:'\u0baa\u0bbf\u0baa\u0bcd\u0bb0\u0bb5\u0bb0\u0bbf',monthMar:'\u0bae\u0bbe\u0bb0\u0bcd\u0b9a\u0bcd',monthApr:'\u0b8f\u0baa\u0bcd\u0bb0\u0bb2\u0bcd',monthMay:'\u0bae\u0bc7',monthJun:'\u0b9c\u0bc2\u0ba9\u0bcd',monthJul:'\u0b9c\u0bc2\u0bb2\u0bc8',monthAug:'\u0b86\u0b95\u0bb8\u0bcd\u0b9f\u0bcd',monthSep:'\u0b9a\u0bc6\u0baa\u0bcd\u0b9f\u0bae\u0bcd\u0baa\u0bb0\u0bcd',monthOct:'\u0b85\u0b95\u0bcd\u0b9f\u0bcb\u0baa\u0bb0\u0bcd',monthNov:'\u0ba8\u0bb5\u0bae\u0bcd\u0baa\u0bb0\u0bcd',monthDec:'\u0b9f\u0bbf\u0b9a\u0bae\u0bcd\u0baa\u0bb0\u0bcd',festivalNavaratri:'\u0ba8\u0bb5\u0bb0\u0bbe\u0ba4\u0bcd\u0ba4\u0bbf\u0bb0\u0bbf',festivalMahaShivaratri:'\u0bae\u0b95\u0bbe \u0b9a\u0bbf\u0bb5\u0bb0\u0bbe\u0ba4\u0bcd\u0ba4\u0bbf\u0bb0\u0bbf',festivalDiwali:'\u0ba4\u0bc0\u0baa\u0bbe\u0bb5\u0bb3\u0bbf',festivalVijayadashami:'\u0bb5\u0bbf\u0b9c\u0baf\u0ba4\u0b9a\u0bae\u0bbf',festivalGaneshChaturthi:'\u0bb5\u0bbf\u0ba8\u0bbe\u0baf\u0b95\u0bb0\u0bcd \u0b9a\u0ba4\u0bc1\u0bb0\u0bcd\u0ba4\u0bcd\u0ba4\u0bbf',festivalKartikaMasam:'\u0b95\u0bbe\u0bb0\u0bcd\u0ba4\u0bcd\u0ba4\u0bbf\u0b95\u0bc8 \u0bae\u0bbe\u0ba4\u0bae\u0bcd',festivalSriRamaNavami:'\u0bb8\u0bcd\u0bb0\u0bc0 \u0bb0\u0bbe\u0bae \u0ba8\u0bb5\u0bae\u0bbf',festivalHanumanJayanti:'\u0bb9\u0ba9\u0bc1\u0bae\u0bbe\u0ba9\u0bcd \u0b9c\u0bc6\u0baf\u0ba8\u0bcd\u0ba4\u0bbf',festivalKrishnaJanmashtami:'\u0b95\u0bbf\u0bb0\u0bc1\u0bb7\u0bcd\u0ba3 \u0b9c\u0bc6\u0baf\u0ba8\u0bcd\u0ba4\u0bbf',festivalUgadi:'\u0baf\u0bc1\u0b95\u0bbe\u0ba4\u0bbf',festivalMakarSankranti:'\u0bae\u0b95\u0bb0 \u0b9a\u0b99\u0bcd\u0b95\u0bb0\u0bbe\u0ba8\u0bcd\u0ba4\u0bbf',festivalGuruPurnima:'\u0b95\u0bc1\u0bb0\u0bc1 \u0baa\u0bc2\u0bb0\u0bcd\u0ba3\u0bbf\u0bae\u0bbe',festivalKartikaPurnima:'\u0b95\u0bbe\u0bb0\u0bcd\u0ba4\u0bcd\u0ba4\u0bbf\u0b95\u0bc8 \u0ba4\u0bc0\u0baa\u0bae\u0bcd',festivalVaikuntaEkadashi:'\u0bb5\u0bc8\u0b95\u0bc1\u0ba3\u0bcd\u0b9f \u0b8f\u0b95\u0bbe\u0ba4\u0b9a\u0bbf',seasonOfDevotion:'\u0baa\u0b95\u0bcd\u0ba4\u0bbf \u0b95\u0bbe\u0bb2\u0bae\u0bcd',panchangam:'\u0baa\u0b9e\u0bcd\u0b9a\u0bbe\u0b99\u0bcd\u0b95\u0bae\u0bcd',upcomingFestivals:'\u0ba4\u0bbf\u0bb0\u0bc1\u0bb5\u0bbf\u0bb4\u0bbe\u0b95\u0bcd\u0b95\u0bb3\u0bcd',festDescKrishnaJanmashtami:'\u0bb8\u0bcd\u0bb0\u0bc0 \u0b95\u0bbf\u0bb0\u0bc1\u0bb7\u0bcd\u0ba3\u0bb0\u0bbf\u0ba9\u0bcd \u0b85\u0bb5\u0ba4\u0bbe\u0bb0 \u0ba4\u0bbf\u0ba9\u0ba4\u0bcd\u0ba4\u0bc8 \u0b9c\u0baa\u0bae\u0bcd \u0bae\u0bb1\u0bcd\u0bb1\u0bc1\u0bae\u0bcd \u0baa\u0b95\u0bcd\u0ba4\u0bbf\u0baf\u0bc1\u0b9f\u0ba9\u0bcd \u0b95\u0bca\u0ba3\u0bcd\u0b9f\u0bbe\u0b9f\u0bc1\u0b99\u0bcd\u0b95\u0bb3\u0bcd.',festDescGaneshChaturthi:'\u0bb5\u0bbf\u0ba8\u0bbe\u0baf\u0b95\u0baa\u0bcd \u0baa\u0bc6\u0bb0\u0bc1\u0bae\u0bbe\u0ba9\u0bc8 \u0bb5\u0bb0\u0bb5\u0bc7\u0bb1\u0bcd\u0bb1\u0bc1 \u0baa\u0bc1\u0ba4\u0bbf\u0baf \u0b86\u0ba9\u0bcd\u0bae\u0bc0\u0b95 \u0b87\u0bb2\u0b95\u0bcd\u0b95\u0bc1\u0b95\u0bb3\u0bc8\u0ba4\u0bcd \u0ba4\u0bca\u0b9f\u0b99\u0bcd\u0b95\u0bc1\u0b99\u0bcd\u0b95\u0bb3\u0bcd.',festDescNavaratri:'\u0b92\u0ba9\u0bcd\u0baa\u0ba4\u0bc1 \u0b87\u0bb0\u0bb5\u0bc1\u0b95\u0bb3\u0bcd \u0ba4\u0bc7\u0bb5\u0bbf \u0bb5\u0bb4\u0bbf\u0baa\u0bbe\u0b9f\u0bc1 \u0bae\u0bb1\u0bcd\u0bb1\u0bc1\u0bae\u0bcd \u0bae\u0ba8\u0bcd\u0ba4\u0bbf\u0bb0 \u0b9c\u0baa\u0bae\u0bcd.',festDescVijayadashami:'\u0b95\u0bc1\u0b9f\u0bc1\u0bae\u0bcd\u0baa \u0b9c\u0baa\u0ba4\u0bcd\u0ba4\u0bc1\u0b9f\u0ba9\u0bcd \u0ba4\u0bb0\u0bcd\u0bae\u0ba4\u0bcd\u0ba4\u0bbf\u0ba9\u0bcd \u0bb5\u0bc6\u0bb1\u0bcd\u0bb1\u0bbf\u0baf\u0bc8 \u0b95\u0bca\u0ba3\u0bcd\u0b9f\u0bbe\u0b9f\u0bc1\u0b99\u0bcd\u0b95\u0bb3\u0bcd.',festDescDiwali:'\u0ba4\u0bc0\u0baa\u0b99\u0bcd\u0b95\u0bb3\u0bbf\u0ba9\u0bcd \u0ba4\u0bbf\u0bb0\u0bc1\u0bb5\u0bbf\u0bb4\u0bbe. \u0b9c\u0baa\u0bae\u0bcd \u0bae\u0bb1\u0bcd\u0bb1\u0bc1\u0bae\u0bcd \u0b85\u0ba9\u0bcd\u0ba9\u0ba4\u0bbe\u0ba9\u0bae\u0bcd \u0b85\u0bb3\u0bbf\u0baf\u0bc1\u0b99\u0bcd\u0b95\u0bb3\u0bcd.',festDescKartikaPurnima:'\u0b9a\u0bbf\u0bb5 \u0bae\u0bb1\u0bcd\u0bb1\u0bc1\u0bae\u0bcd \u0bb5\u0bbf\u0bb7\u0bcd\u0ba3\u0bc1 \u0b9c\u0baa\u0ba4\u0bcd\u0ba4\u0bbf\u0bb1\u0bcd\u0b95\u0bbe\u0ba9 \u0baa\u0bc1\u0ba9\u0bbf\u0ba4 \u0b95\u0bbe\u0bb0\u0bcd\u0ba4\u0bcd\u0ba4\u0bbf\u0b95\u0bc8 \u0baa\u0bcc\u0bb0\u0bcd\u0ba3\u0bae\u0bbf.',festDescMahaShivaratri:'\u0b9a\u0bbf\u0bb5\u0baa\u0bc6\u0bb0\u0bc1\u0bae\u0bbe\u0ba9\u0bbf\u0ba9\u0bcd \u0b87\u0bb0\u0bb5\u0bc1 \u0bae\u0bc1\u0bb4\u0bc1\u0bb5\u0ba4\u0bc1\u0bae\u0bcd \u0bb5\u0bb4\u0bbf\u0baa\u0bbe\u0b9f\u0bc1 \u0bae\u0bb1\u0bcd\u0bb1\u0bc1\u0bae\u0bcd \u0b9c\u0bbe\u0b95\u0bb0\u0ba3\u0bc8.',festDescKartikaMasam:'\u0b9a\u0bbf\u0bb5 \u0bae\u0bb1\u0bcd\u0bb1\u0bc1\u0bae\u0bcd \u0bb5\u0bbf\u0bb7\u0bcd\u0ba3\u0bc1\u0bb5\u0bc1\u0b95\u0bcd\u0b95\u0bc1 \u0b85\u0bb0\u0bcd\u0baa\u0bcd\u0baa\u0ba3\u0bbf\u0b95\u0bcd\u0b95\u0baa\u0bcd\u0baa\u0b9f\u0bcd\u0b9f \u0baa\u0bc1\u0ba9\u0bbf\u0ba4 \u0bae\u0bbe\u0ba4\u0bae\u0bcd.'})},657,[1,652]);
